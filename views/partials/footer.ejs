<footer class="site-footer" itemscope itemtype="https://schema.org/LocalBusiness">
  <meta itemprop="name" content="<%= brand.legalName %>" />
  <div class="footer-grid">
    <div>
      <div class="footer-brand-row">
        <img src="/media/logo.png" alt="Solar Bright solar wash Lahore" width="44" height="44" itemprop="image" />
        <p class="footer-brand"><%= brand.name %></p>
      </div>
      <p class="footer-copy" itemprop="description">
        <%= brand.tagline %>. Professional <strong>solar panel cleaning in Lahore</strong> — solar wash near you for homes and commercial rooftops.
      </p>
      <p class="footer-areas">Serving <%= brand.areaServed.slice(0, 6).join(", ") %> &amp; more.</p>
    </div>
    <div>
      <p class="footer-label">Explore</p>
      <div class="footer-links">
        <% Object.entries(pages).forEach(([key, page]) => { %>
          <a href="<%= page.path %>"><%= page.nav || page.title %></a>
        <% }) %>
      </div>
    </div>
    <div itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
      <p class="footer-label">Lahore office</p>
      <p class="footer-meta">
        <span itemprop="streetAddress"><%= brand.streetAddress %></span>,
        <span itemprop="addressLocality"><%= brand.addressLocality %></span>,
        <span itemprop="addressRegion"><%= brand.addressRegion %></span>,
        <span itemprop="addressCountry">Pakistan</span>
      </p>
      <a href="tel:<%= brand.phoneTel %>" itemprop="telephone"><%= brand.phone %></a>
      <p class="footer-meta">
        <a href="<%= brand.whatsappQuoteUrl %>" target="_blank" rel="noopener noreferrer">WhatsApp <%= brand.whatsappDisplay %></a>
      </p>
      <a href="mailto:<%= brand.email %>" itemprop="email"><%= brand.email %></a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© <%= year %> <%= brand.name %> · Solar wash &amp; solar panel cleaning · <%= brand.fullAddress %></p>
  </div>
</footer>

<a
  class="whatsapp-float"
  href="<%= brand.whatsappQuoteUrl %>"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp for solar wash Lahore"
>
  <span class="whatsapp-float-icon" aria-hidden="true">
