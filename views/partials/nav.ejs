<header class="site-header">
  <a class="brand" href="/" data-animate="nav" title="Solar Bright — solar panel cleaning Lahore">
    <img class="brand-logo" src="/media/logo.png" alt="Solar Bright logo — solar wash Lahore" width="48" height="48" />
    <span class="brand-text">
      <span class="brand-name">
        <span class="brand-solar">Solar</span>
        <span class="brand-bright">Bright</span>
      </span>
      <span class="brand-tag"><%= brand.tagline %> · Lahore</span>
    </span>
  </a>

  <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span>
  </button>

  <nav class="site-nav" data-animate="nav" aria-label="Primary">
    <% Object.entries(pages).forEach(([key, page]) => { %>
      <a
        href="<%= page.path %>"
        class="nav-link<%= current === key ? ' is-active' : '' %>"
      ><%= page.nav || page.title %></a>
    <% }) %>
    <a class="nav-cta" href="<%= brand.whatsappQuoteUrl %>" target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </nav>
</header>
