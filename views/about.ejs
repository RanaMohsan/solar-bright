<%- include('partials/head') %>
<%- include('partials/nav') %>

<main id="main-content">
  <section class="page-hero">
    <p class="section-label" data-animate="hero">About · Lahore</p>
    <h1 data-animate="hero">Solar wash experts on PIA Main Road.</h1>
    <p data-animate="hero"><%= brand.name %> helps Lahore homes and businesses get more power from every panel. <%= brand.tagline %>.</p>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="section-narrow split">
      <div class="media-frame reveal">
        <img src="/media/before-after-roof.png" alt="Solar Bright Lahore before and after solar panel cleaning" loading="lazy" />
      </div>
      <div>
        <p class="section-label reveal">Our promise</p>
        <h2 class="section-title reveal">Local team. Clear results.</h2>
        <p class="section-lead reveal">
          Based on <strong>PIA Main Road, Lahore</strong>, we specialise in <strong>solar panel cleaning</strong> and <strong>solar wash near me</strong> jobs across the city — soft brush, careful rinse, honest WhatsApp booking on <%= brand.phone %>.
        </p>
        <div class="stats stagger">
          <div class="stat">
            <strong data-count="5">0</strong>
            <span>★ customer reviews</span>
          </div>
          <div class="stat">
            <strong data-count="11">0</strong>
            <span>Lahore areas served</span>
          </div>
          <div class="stat">
            <strong data-count="100">0</strong>
            <span>% soft-wash focus</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-narrow">
      <p class="section-label reveal">How we work</p>
      <h2 class="section-title reveal">Inspect · Wash · Reveal</h2>
      <div class="service-grid stagger">
        <article class="service-item">
          <h3>Inspect</h3>
          <p>We check access, tilt, and dust level on your Lahore rooftop before washing.</p>
        </article>
        <article class="service-item">
          <h3>Wash</h3>
          <p>Soft brushes lift grit safely so glass stays clear and unscratched.</p>
        </article>
        <article class="service-item">
          <h3>Reveal</h3>
          <p>You see the before/after shine — panels ready for full Punjabi sun.</p>
        </article>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
