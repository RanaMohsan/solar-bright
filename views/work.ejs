<%- include('partials/head') %>
<%- include('partials/nav') %>

<main id="main-content">
  <section class="page-hero">
    <p class="section-label" data-animate="hero">Results · Lahore</p>
    <h1 data-animate="hero">Solar wash proof you can see.</h1>
    <p data-animate="hero">Before &amp; after solar panel cleaning from Solar Bright jobs in Lahore — same media as our home reel.</p>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="section-narrow">
      <div class="work-grid stagger">
        <article class="work-item">
          <div class="work-thumb">
            <video src="/media/clean-demo-1.mp4" muted loop playsinline controls title="Solar panel cleaning video Lahore"></video>
          </div>
          <p class="work-meta">Video · Lahore rooftop</p>
          <h3>Cleaning pass one</h3>
          <p>Watch foam and brush travel across dusty solar glass.</p>
        </article>
        <article class="work-item">
          <div class="work-thumb">
            <video src="/media/clean-demo-2.mp4" muted loop playsinline controls title="Solar wash detail video Lahore"></video>
          </div>
          <p class="work-meta">Video · Detail</p>
          <h3>Cleaning pass two</h3>
          <p>Closer motion as dirt lifts and blue cells return.</p>
        </article>
        <article class="work-item">
          <div class="work-thumb">
            <img src="/media/cleaning-closeup.png" alt="Solar wash close-up dirty vs clean panel Lahore" loading="lazy" />
          </div>
          <p class="work-meta">Still · Close-up</p>
          <h3>Half dirty, half bright</h3>
          <p>The diagonal reveal that shows why solar wash matters in Lahore dust.</p>
        </article>
        <article class="work-item">
          <div class="work-thumb">
            <img src="/media/before-after-roof.png" alt="Clean solar panels among dusty array after Solar Bright wash Lahore" loading="lazy" />
          </div>
          <p class="work-meta">Still · Array</p>
          <h3>Island of clean cells</h3>
          <p>Restored panels shining in the middle of a dusty rooftop field.</p>
        </article>
      </div>

      <div class="cta-row" style="margin-top: 2.5rem;">
        <a class="btn btn-sun reveal" href="<%= brand.whatsappQuoteUrl %>" target="_blank" rel="noopener noreferrer">Book via WhatsApp</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
